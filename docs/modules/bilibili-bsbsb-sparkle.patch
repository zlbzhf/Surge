+
+function mergeSegments(segments: AirborneSegment[], options: SponsorBlockOptions): AirborneSegment[] {
+    const skipSegments = segments
+        .filter(segment => segment.actionType === 'skip')
+        .sort((left, right) => left.start - right.start);
+    const merged: AirborneSegment[] = [];
+    for (const segment of skipSegments) {
