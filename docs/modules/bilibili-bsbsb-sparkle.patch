+function readCachedSegments(ctx: Context, cacheKey: string, cacheMinutes: number): AirborneSegment[] | null {
+    if (cacheMinutes <= 0) return null;
+    try {
+        const cached = ctx.getJSON(cacheKey) as { createdAt?: number; segments?: AirborneSegment[] } | null;
+        if (!cached?.createdAt || !Array.isArray(cached.segments)) return null;
+        if (Date.now() - cached.createdAt > cacheMinutes * 60 * 1000) return null;
+        return cached.segments;
+    } catch {
+        return null;
+    }
+}
+
+function writeCachedSegments(ctx: Context, cacheKey: string, segments: AirborneSegment[], cacheMinutes: number): void {
+    if (cacheMinutes <= 0) return;
+    try {
+        ctx.setJSON({ createdAt: Date.now(), segments }, cacheKey);
+    } catch (e) {
+        Logger.debug('[SponsorBlock] cache write failed', e);
+    }
