+function buildCacheKey(videoId: string, cid: string, options: SponsorBlockOptions): string {
+    return [
+        'bsbsb.airborne.v1',
+        videoId,
+        cid,
+        options.categories.join('|'),
+        options.actionTypes.join('|'),
+        options.minDuration,
+        options.mergeGap,
+    ].join(':');
+}
+
+function readCachedSegments(ctx: Context, cacheKey: string, cacheMinutes: number): AirborneSegment[] | null {
+    if (cacheMinutes <= 0) return null;
+    try {
+        const cached = ctx.getJSON(cacheKey) as { createdAt?: number; segments?: AirborneSegment[] } | null;
+        if (!cached?.createdAt || !Array.isArray(cached.segments)) return null;
+        if (Date.now() - cached.createdAt > cacheMinutes * 60 * 1000) return null;
+        return cached.segments;
+    } catch {
+        return null;
+    }
+}
+
+function writeCachedSegments(ctx: Context, cacheKey: string, segments: AirborneSegment[], cacheMinutes: number): void {
+    if (cacheMinutes <= 0) return;
+    try {
+        ctx.setJSON({ createdAt: Date.now(), segments }, cacheKey);
+    } catch (e) {
+        Logger.debug('[SponsorBlock] cache write failed', e);
+    }
+}
+
+function parseSegments(body: string, options: SponsorBlockOptions): AirborneSegment[] {
+    const categories = new Set(options.categories);
+    const actionTypes = new Set(options.actionTypes);
+    const parsed = (JSON.parse(body) as SegmentItem[]).reduce((memo: AirborneSegment[], item) => {
+        const segment = item.segment;
+        if (!Array.isArray(segment) || segment.length < 2) return memo;
+        const start = Number(segment[0]);
+        const end = Number(segment[1]);
+        if (!Number.isFinite(start) || !Number.isFinite(end)) return memo;
+        if (!categories.has(item.category) || !actionTypes.has(item.actionType)) return memo;
+
+        if (item.actionType === 'poi') {
+            memo.push({ start, end: start, category: item.category, actionType: item.actionType, UUID: item.UUID });
+            return memo;
         }
+
+        if (end <= start || end - start < options.minDuration) return memo;
+        memo.push({ start, end, category: item.category, actionType: item.actionType, UUID: item.UUID });
         return memo;
     }, []);
+
+    return mergeSegments(parsed, options).slice(0, options.maxSegments);
+}
+
+function mergeSegments(segments: AirborneSegment[], options: SponsorBlockOptions): AirborneSegment[] {
+    const skipSegments = segments
+        .filter(segment => segment.actionType === 'skip')
+        .sort((left, right) => left.start - right.start);
+    const merged: AirborneSegment[] = [];
+    for (const segment of skipSegments) {
+        const last = merged.at(-1);
+        if (last && segment.start <= last.end + options.mergeGap) {
+            last.end = Math.max(last.end, segment.end);
+            if (last.category !== segment.category) last.category = 'sponsor';
+            continue;
+        }
+        merged.push({ ...segment });
+    }
+
+    return [
+        ...merged,
+        ...segments.filter(segment => segment.actionType !== 'skip'),
