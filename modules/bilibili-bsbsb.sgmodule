#!name=BilibiliSponsorBlock 空降助手
#!desc=基于 bsbsb.top / 小电视空降助手，为 B 站 App 注入可配置空降点；不包含 B 站去广告、皮肤、直播或账号相关改写。
#!category=Enhancement
#!arguments=空降助手:bilibili.bsbsb.airborne,类别:sponsor|selfpromo|interaction,动作类型:skip,片头片尾:0,高能点:0,开头汇总弹幕:0,汇总弹幕毫秒:3000,系统通知:0,通知冷却分钟:30,UI观测:0,最短片段秒数:5,合并间隔秒数:1.5,空降提前毫秒:2000,最大注入数:12,缓存分钟:60,API策略:DIRECT,日志等级:3
#!arguments-desc=空降助手\n- bilibili.bsbsb.airborne: 开启\n- #: 关闭整条脚本\n\n类别\n- 默认 sponsor|selfpromo|interaction\n- 可手动追加 intro|outro|padding|music_offtopic|poi_highlight\n- 使用竖线分隔，避免 Surge 模块参数逗号歧义\n\n动作类型\n- 默认 skip\n- 启用高能点时脚本会自动追加 poi\n\n片头片尾\n- 0: 关闭 intro/outro/padding/music_offtopic\n- 1: 开启这些更激进类别\n\n高能点\n- 0: 关闭 poi_highlight\n- 1: 开启高能点空降提示\n\n开头汇总弹幕\n- 0: 默认关闭，避免实验性汇总弹幕影响 B 站原生弹幕层\n- 1: 开启后在视频开头插入汇总提示；如果首个分段查询超时，会在第一个成功分段补提示\n\n汇总弹幕毫秒\n- 默认 3000，控制汇总弹幕出现时间；如果开头片段会被自动跳过，脚本会顺延到跳过目标后显示\n\n系统通知\n- 0: 默认关闭\n- 1: 有空降/高能片段时通过 Surge 发系统通知\n\n通知冷却分钟\n- 默认 30，避免同一视频反复弹通知；设为 0 可不限制\n\nUI观测\n- 0: 默认关闭\n- 1: 只读记录 DmView/ViewProgress 中的互动弹幕、ContractCard、OperationCard 等卡片元数据，便于后续按真实样本实现原生卡片\n\n最短片段秒数\n- 默认 5，过滤太短的 skip 片段\n\n合并间隔秒数\n- 默认 1.5，合并相邻/重叠片段\n\n空降提前毫秒\n- 默认 2000；skip 片段在开始后显示，poi 高能点在目标前显示\n\n最大注入数\n- 默认 12，避免弹幕列表污染\n\n缓存分钟\n- 默认 60；设为 0 可关闭缓存\n\nAPI策略\n- bsbsb.top 的访问策略；DIRECT 不稳可改为 Proxy 或指定策略组\n\n日志等级\n- 1 DEBUG\n- 2 INFO\n- 3 WARN\n- 4 ERROR\n- 5 OFF

[Rule]
DOMAIN,bsbsb.top,{{{API策略}}}

[Script]
{{{空降助手}}} = type=http-request,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$,argument="{"categories":"{{{类别}}}","actionTypes":"{{{动作类型}}}","includeIntroOutro":"{{{片头片尾}}}","includePoiHighlight":"{{{高能点}}}","summaryDanmaku":"{{{开头汇总弹幕}}}","summaryDanmakuMs":"{{{汇总弹幕毫秒}}}","systemNotification":"{{{系统通知}}}","notificationCooldownMinutes":"{{{通知冷却分钟}}}","minDuration":"{{{最短片段秒数}}}","mergeGap":"{{{合并间隔秒数}}}","offsetMs":"{{{空降提前毫秒}}}","maxSegments":"{{{最大注入数}}}","cacheMinutes":"{{{缓存分钟}}}","logLevel":"{{{日志等级}}}"}",requires-body=1,binary-body-mode=1,max-size=-1,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/bilibili-bsbsb.airborne.js?v=20260523-summary-default-off-1
bilibili.bsbsb.chronos = type=http-response,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/(?:bilibili\.community\.service\.dm\.v1\.DM\/DmView|bilibili\.app\.(?:view\.v1\.View|viewunite\.v1\.View)\/ViewProgress)$,argument="{"sponsorBlock":"{{{空降助手}}}","uiObservation":"{{{UI观测}}}","logLevel":"{{{日志等级}}}"}",requires-body=1,binary-body-mode=1,max-size=-1,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/bilibili-bsbsb.airborne.js?v=20260523-summary-default-off-1

[MITM]
hostname = %APPEND% grpc.biliapi.net, app.bilibili.com
