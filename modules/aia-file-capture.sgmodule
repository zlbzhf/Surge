#!name=AIA 文件捕获 / AIA File Capture
#!desc=浏览友邦 AIA 页面/App H5 时捕获产品图片/PDF/资料链接，并诊断 H5/mPaaS/SOP 元数据。窄域 MITM；不读取二进制 body，不改响应，不保存会话凭据/请求头。
#!category=Utility
[Script]
aia.file.capture.response = type=http-response,pattern=^https?:\/\/(?:(?:www|cws|nav|nav-st|nav-uat)\.aia\.com\.cn|01000001\.h5\.aia\.com)\/.+,requires-body=false,max-size=0,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-h5-mpaas-diagnostic-v1,argument=mode=capture&keep=200&notify=1&min_bytes=0&kinds=image|pdf|office|archive&query=redact&context_ttl=60&archive_url=https%3A%2F%2Faia.zuiai.ggff.net%2Farchive
aia.file.capture.context = type=http-response,pattern=^https?:\/\/(?:www|cws|nav)\.aia\.com\.cn\/(?!(?:.*\.(?:pdf|png|jpe?g|webp|gif|svg|mp4|zip|docx?|xlsx?|pptx?)(?:[?#]|$))).+,requires-body=1,max-size=1048576,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-h5-mpaas-diagnostic-v1,argument=mode=context&keep=200&keep_context=80&harvest_links=1&archive_page=1&notify_context=0&archive_url=https%3A%2F%2Faia.zuiai.ggff.net%2Farchive
aia.file.capture.diagnostic.mpaas = type=http-response,pattern=^https?:\/\/mpaas-mgw-fin\.cn-shanghai\.aliyuncs\.com\/.+,requires-body=false,max-size=0,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-h5-mpaas-diagnostic-v1,argument=mode=diagnostic&keep=200&notify_diag=1
aia.file.capture.diagnostic.h5 = type=http-response,pattern=^https?:\/\/01000001\.h5\.aia\.com\/.+,requires-body=1,max-size=1048576,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-h5-mpaas-diagnostic-v1,argument=mode=diagnostic&keep=200&keep_context=80&notify_diag=1
aia.file.capture.diagnostic.sop = type=http-response,pattern=^https?:\/\/sop\.aia\.com\.cn\/.+,requires-body=false,max-size=0,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-h5-mpaas-diagnostic-v1,argument=mode=diagnostic&keep=200&notify_diag=1
aia.file.capture.panel = type=generic,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-h5-mpaas-diagnostic-v1,argument=mode=panel
aia.file.capture.export = type=generic,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-h5-mpaas-diagnostic-v1,argument=mode=export&limit=80
aia.file.capture.clear = type=generic,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-h5-mpaas-diagnostic-v1,argument=mode=clear&context=true

[Panel]
AIA 文件捕获 = script-name=aia.file.capture.panel,update-interval=60
AIA 文件捕获导出 = script-name=aia.file.capture.export,update-interval=3600

[MITM]
hostname = %APPEND% www.aia.com.cn, cws.aia.com.cn, nav.aia.com.cn, 01000001.h5.aia.com, mpaas-mgw-fin.cn-shanghai.aliyuncs.com, sop.aia.com.cn, nav-st.aia.com.cn, nav-uat.aia.com.cn

# 使用方式：
# 1. 安装模块后确保 Surge 已信任 MITM 证书。
# 2. 打开 AIA 官网/导航器产品页或 App 内 H5 产品页；页面/API 上下文会记录产品名。
# 3. PDF/图片响应会自动关联最近产品上下文；公开披露 API 字段会补全条款、费率表、现金价值表、产品说明书 PDF URL。
# 4. 如果产品资料页只列出“宣传彩页/产品条款/产品合同”等入口页，脚本会把产品页提交给归档服务，由 VPS 抓取入口页并提取最终文件。
# 5. 诊断版会额外监听 01000001.h5.aia.com、mPaaS、SOP 事件域，只记录脱敏 URL、标题/产品名、Operation-Type、加密标记和响应大小；不保存会话凭据/请求头/正文。
# 6. 面板显示最近捕获；“AIA 文件捕获导出”面板给 CSV 文本，可复制出来继续整理。
# 7. 响应捕获、API 补全和产品页抓取出的文件会发给归档服务下载保存；当前测试版不带 token 参数。诊断记录仅保存在 Surge 本地，不发归档服务。
# 8. 仅窄域 MITM，不要改成 hostname=*。
