#!name=AIA 文件捕获 / AIA File Capture
#!desc=浏览友邦 AIA 页面时捕获产品图片/PDF/资料链接；可关联产品名、资料类型并 CSV 导出。窄域 MITM，仅 www/cws/nav.aia.com.cn；不读取二进制 body，不改响应。
#!category=Utility
[Script]
aia.file.capture.response = type=http-response,pattern=^https?:\/\/(?:www|cws|nav)\.aia\.com\.cn\/.+,requires-body=false,max-size=0,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-no-token-v1,argument=mode=capture&keep=160&notify=1&min_bytes=0&kinds=image|pdf|office|archive&query=redact&context_ttl=60&archive_url=https%3A%2F%2Faia.zuiai.ggff.net%2Farchive
aia.file.capture.context = type=http-response,pattern=^https?:\/\/(?:www|cws|nav)\.aia\.com\.cn\/(?!(?:.*\.(?:pdf|png|jpe?g|webp|gif|svg|mp4|zip|docx?|xlsx?|pptx?)(?:[?#]|$))).+,requires-body=1,max-size=1048576,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-no-token-v1,argument=mode=context&keep=160&keep_context=60&harvest_links=1&notify_context=0&archive_url=https%3A%2F%2Faia.zuiai.ggff.net%2Farchive
aia.file.capture.panel = type=generic,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-no-token-v1,argument=mode=panel
aia.file.capture.export = type=generic,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-no-token-v1,argument=mode=export&limit=60
aia.file.capture.clear = type=generic,timeout=5,script-path=https://raw.githubusercontent.com/zlbzhf/Surge/main/modules/scripts/file-capture.js?cb=aia-no-token-v1,argument=mode=clear&context=true

[Panel]
AIA 文件捕获 = script-name=aia.file.capture.panel,update-interval=60
AIA 文件捕获导出 = script-name=aia.file.capture.export,update-interval=3600

[MITM]
hostname = %APPEND% www.aia.com.cn, cws.aia.com.cn, nav.aia.com.cn

# 使用方式：
# 1. 安装模块后确保 Surge 已信任 MITM 证书。
# 2. 打开 AIA 官网/导航器产品页；页面/API 上下文会记录产品名。
# 3. PDF/图片响应会自动关联最近产品上下文；公开披露 API 字段会补全条款、费率表、现金价值表、产品说明书 PDF URL。
# 4. 面板显示最近捕获；“AIA 文件捕获导出”面板给 CSV 文本，可复制出来继续整理。
# 5. 响应捕获和 API 补全出的文件会发给归档服务下载保存；当前测试版不带 token 参数。
# 6. 仅窄域 MITM，不要改成 hostname=*。
